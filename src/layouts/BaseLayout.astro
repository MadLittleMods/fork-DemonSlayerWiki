  <div class="main-ino-container">
    <slot />
  </div>

  <footer>Wiki inspired by the <a class="link" href="https://kimetsu-no-yaiba.fandom.com/" target="_blank">Kimetsu No
      Yaiba Wiki</a></footer>
  <script src="/javascripts/searchbar.js" is:inline></script>
  <script src="/javascripts/slideshow.js" is:inline></script>
  <script src="/javascripts/homepage.js" is:inline></script>
  <script src="/javascripts/navigation.js" is:inline></script>
  <slot name="scripts" />
