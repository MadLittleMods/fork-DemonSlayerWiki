---
import '../styles/global.css';

// This allows us to compose the interface as bare props for `.astro` or under
// the `frontmatter` field for `.md` and `.mdx`
interface IProps {
title: string;
}
export interface Props extends IProps {
frontmatter?: IProps;
}

// Using one Layout for .md, .mdx, and .astro:
// https://docs.astro.build/en/core-concepts/layouts/#using-one-layout-for-md-mdx-and-astro
const { title } = Astro.props.frontmatter || Astro.props;
---

