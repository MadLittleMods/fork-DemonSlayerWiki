---
import '../styles/global.css';

// This allows us to compose the interface as bare props for `.astro` or under
// the `frontmatter` field for `.md` and `.mdx`
interface IProps {
title: string;
}
export interface Props extends IProps {
frontmatter?: IProps;
}

// Using one Layout for .md, .mdx, and .astro:
// https://docs.astro.build/en/core-concepts/layouts/#using-one-layout-for-md-mdx-and-astro
const { title } = Astro.props.frontmatter || Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Demon Slayer Wiki</title>
</head>

<body>
  <div class="navbar">
    <a href={`${import.meta.env.BASE_URL}index.html`}><img src={`${import.meta.env.BASE_URL}images/Demon-Slayer-Logo.png`} alt="Demon Slayer Logo" class="fiximg" /></a>
    <a href={`${import.meta.env.BASE_URL}index.html`} class="nav-item">Home</a>
    <div class="dropdown">
      <a href={`${import.meta.env.BASE_URL}characters.html`} class="nav-item">Characters</a>
      <div class="dropdown-content">
        <div class="ds">
          Demon Slayers
          <div class="ds-dropdown-content">
            <a href={`${import.meta.env.BASE_URL}tanjiro.html`}>Tanjiro Kamado</a>
            <a href={`${import.meta.env.BASE_URL}zenitzu.html`}>Zenitsu Agatsuma</a>
            <a href={`${import.meta.env.BASE_URL}inosuke.html`}>Inosuke Hashibira</a>
            <a href={`${import.meta.env.BASE_URL}kanao.html`}>Kanao Tsuyuri</a>
