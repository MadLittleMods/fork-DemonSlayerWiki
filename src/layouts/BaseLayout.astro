            <a href={`${import.meta.env.BASE_URL}Characters/Tengen_Uzui/info.html`}>Tengen Uzui</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Muichiro_Tokito/info.html`}>Muichiro Tokito</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Mitsuri_Kanroji/info.html`}>Mitsuri Kanroji</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Obanai_Iguro/info.html`}>Obanai Iguro</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Gyomei_Himejima/info.html`}>Gyomei Himejima</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Sanemi_Shinazugawa/info.html`}>Sanemi Shinazugawa</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Kanae_Kocho/info.html`}>Kanae Kocho</a>
          </div>
        </div>
        <div class="ds">
          Ubuyashiki Family
          <div class="ds-dropdown-content">
            <a href={`${import.meta.env.BASE_URL}Characters/Kagaya_Ubuyashiki/info.html`}>Kagaya Ubuyashiki</a>
