    </div>
    <div class="nav-item">
      <form id="search-form" role="search">
        <label for="search-input">Search Wiki:</label>
        <input type="text" id="search-input" placeholder="Enter keywords..." aria-label="Search through project content"
          autocomplete="off">
        <button id="search-button">Search</button>
      </form>
      <div id="search-results"></div>
    </div>
  </div>

  <!-- Overlays (e.g. the lightbox modal) that must sit outside the flex
       container rather than become one of its flex items. -->
  <slot name="before-content" />

  <div class="main-ino-container">
    <slot />
  </div>

  <footer>Wiki inspired by the <a class="link" href="https://kimetsu-no-yaiba.fandom.com/" target="_blank">Kimetsu No
      Yaiba Wiki</a></footer>
  <!-- Everything under `public/` is copied verbatim, so Vite never processes
       it and `import.meta.env.BASE_URL` is unavailable inside those scripts.
       Hand the base path over on `window` instead -- they join their own image
       and page paths against it. Must load before any of them. -->
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    window.__BASE__ = base;
  </script>
  <script src={`${import.meta.env.BASE_URL}javascripts/searchbar.js`} is:inline></script>
  <script src={`${import.meta.env.BASE_URL}javascripts/navigation.js`} is:inline></script>
  <slot name="scripts" />
</body>

</html>
