---
import '../styles/global.css';

// This allows us to compose the interface as bare props for `.astro` or under
// the `frontmatter` field for `.md` and `.mdx`
interface IProps {
title: string;
}
export interface Props extends IProps {
frontmatter?: IProps;
}

// Using one Layout for .md, .mdx, and .astro:
// https://docs.astro.build/en/core-concepts/layouts/#using-one-layout-for-md-mdx-and-astro
const { title } = Astro.props.frontmatter || Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Demon Slayer Wiki</title>
</head>

<body>
  <div class="navbar">
    <a href="/index.html"><img src="/images/Demon-Slayer-Logo.png" alt="Demon Slayer Logo" class="fiximg" /></a>
    <a href="/index.html" class="nav-item">Home</a>
    <div class="dropdown">
      <a href="/characters.html" class="nav-item">Characters</a>
      <div class="dropdown-content">
        <div class="ds">
          Demon Slayers
          <div class="ds-dropdown-content">
            <a href="">Tanjiro Kamado</a>
            <a href="">Zenitsu Agatsuma</a>
            <a href="">Inosuke Hashibira</a>
            <a href="">Kanao Tsuyuri</a>
            <a href="">Genya Shinazugawa</a>
          </div>
        </div>
        <div class="ds">
          Hashira
          <div class="ds-dropdown-content">
            <a href="/Characters/Giyu_Tomioka/info.html">Giyu Tomioka</a>
