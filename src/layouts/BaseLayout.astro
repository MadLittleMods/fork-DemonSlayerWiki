            <a href={`${import.meta.env.BASE_URL}Characters/Kuina_Ubuyashiki/info.html`}>Kuina Ubuyashiki</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Hinaki_Ubuyashiki/info.html`}>Hinaki Ubuyashiki</a>
            <a href={`${import.meta.env.BASE_URL}Characters/Nichika_Ubuyashiki/info.html`}>Nichika Ubuyashiki</a>
