---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Characters">

        <div class="left-side-ino-text">
            <br>
            <button onclick="topFunction()" id="myBtn" title="Go to top" class="topBtn">↑</button>
            <h1>Characters</h1>

            <div class="link-tabs">
                <div class="link-space current-page">
                    <a href="" class="link">Characters</a>
                </div>
                <div class="link-space">
                    <a href={`${import.meta.env.BASE_URL}Characters/Minor.html`} class="link">Minor</a>
                </div>
            </div>

            <p>
                List of <b>characters</b> from the manga and anime series <i>Kimetsu no Yaiba</i>. Additional unnamed
                and minor
                characters can be found on <a href={`${import.meta.env.BASE_URL}Characters/Minor.html`} class="link">this
                    page</a>.
            </p>

            <div>
                <div class="char-tabs">
                    <ul style="display: flex; flex-direction: row; list-style-type: none; gap: 20px;">
                        <li>
                            <div id="op1" style="border-bottom: 2px solid gold;">
                                <a href="#Anime" class="link" id="anime-char-tab">Anime</a>
                            </div>
                        </li>
                        <li>
                            <div id="op2">
                                <a href="#Manga" class="link" id="manga-char-tab">Manga</a>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="anime-content" id="anime-content">
                    <br>
                    <h1>Anime Status</h1>
                    <div class="char-spoiler">
                        Click the 'Manga' tab to reveal the statuses of members as of <a href="#" class="link">Chapter
                            204</a>.
                        Beware of spoilers.
                    </div>
